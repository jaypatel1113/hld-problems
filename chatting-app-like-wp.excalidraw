      "link": null,
      "locked": false,
      "text": "Group Operations\n    POST /v1/groups/create — Create group with members list\n    GET /v1/groups/{groupId}/messages — Lazy load group messages with pagination\n    POST /v1/groups/add — add member to the group\n    POST /v1/groups/remove — remove member from the group",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Group Operations\n    POST /v1/groups/create — Create group with members list\n    GET /v1/groups/{groupId}/messages — Lazy load group messages with pagination\n    POST /v1/groups/add — add member to the group\n    POST /v1/groups/remove — remove member from the group",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "u_hfYkTqtnNFiVR67hsOz",
      "type": "text",
      "x": 8643.21922580383,
      "y": 31045.461377043932,
      "width": 559.2996826171875,
      "height": 280,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#b2f2bb",
