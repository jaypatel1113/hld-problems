      "updated": 1776902916331,
      "link": null,
      "locked": false,
      "text": "read throughput = 1b * 100 * 3\n\n            300b messages / day\n  \n\n            300b / 100k    =     3M write request/ second",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "read throughput = 1b * 100 * 3\n\n            300b messages / day\n  \n\n            300b / 100k    =     3M write request/ second",
      "autoResize": true,
      "lineHeight": 1.25
    },
