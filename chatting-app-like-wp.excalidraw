    {
      "id": "o2fkRuBgzrmfGlvPnO9Dn",
      "type": "text",
      "x": 8643.219226055426,
      "y": 27173.90077062427,
      "width": 559.2996826171875,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a0",
      "roundness": null,
      "seed": 1999506053,
      "version": 69,
      "versionNonce": 1562432421,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776886599124,
      "link": null,
      "locked": false,
      "text": "Functional Requirements:\n    1. User should be able to register/login\n    2. One-to-one messaging\n    3. Group messaging\n    4. Support both Text/Media message\n    5. Message history\n    6. Message Status: Delivery/Read receipts\n    7. Last seen and Online status",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements:\n    1. User should be able to register/login\n    2. One-to-one messaging\n    3. Group messaging\n    4. Support both Text/Media message\n    5. Message history\n    6. Message Status: Delivery/Read receipts\n    7. Last seen and Online status",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "JJ2hRg3xdQn_8gHlJANL5",
      "type": "text",
      "x": 9296.719226055426,
      "y": 27173.90077062427,
      "width": 729.847412109375,
      "height": 245,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a1",
      "roundness": null,
      "seed": 624447819,
      "version": 290,
      "versionNonce": 855577125,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776886714200,
      "link": null,
      "locked": false,
      "text": "Non-Functional Requirements\n    1. Scale: 1 Billion users, 100msg/day\n        ->100B msg/day (1kb*100B = 100TB/day)\n    2. CAP: Availability >> consistency (7 9's - 99.99999%)\n    3. low-latency < 300ms\n    4. Highly reliable with no message loss\n    5. Messages : End to end encrypted",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-Functional Requirements\n    1. Scale: 1 Billion users, 100msg/day\n        ->100B msg/day (1kb*100B = 100TB/day)\n    2. CAP: Availability >> consistency (7 9's - 99.99999%)\n    3. low-latency < 300ms\n    4. Highly reliable with no message loss\n    5. Messages : End to end encrypted",
      "autoResize": true,
      "lineHeight": 1.25
    },
