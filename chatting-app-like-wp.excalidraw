      "text": "Message is turned into secret code\nOnly sender and receiver can read it",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Message is turned into secret code\nOnly sender and receiver can read it",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hkgVAnFubPHfcgd9i35CY",
      "type": "text",
      "x": 10625.363338033225,
      "y": 39179.53622768702,
      "width": 435.5116882324219,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b19",
      "roundness": null,
      "seed": 1040820875,
      "version": 479,
      "versionNonce": 878523275,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776915257688,
      "link": null,
      "locked": false,
      "text": "Max writes message\n    normal text\nMessage gets encrypted\n    converted to secret form\nEncrypted message goes to server\n    server cannot read it\nServer sends to Emily\n    still encrypted\nEmily decrypts message\n    converts back to normal text",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Max writes message\n    normal text\nMessage gets encrypted\n    converted to secret form\nEncrypted message goes to server\n    server cannot read it\nServer sends to Emily\n    still encrypted\nEmily decrypts message\n    converts back to normal text",
      "autoResize": true,
      "lineHeight": 1.25
    },
