    {
      "id": "Bpz6kqJZuAu7Z9xmluDKG",
      "type": "text",
      "x": 8658.924189732637,
      "y": 27803.86953763798,
      "width": 765.155517578125,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a6",
      "roundness": null,
      "seed": 113429579,
      "version": 310,
      "versionNonce": 1663582405,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776902916331,
      "link": null,
      "locked": false,
      "text": "write throuput: \n    no of ways to write in the system (adding / updatin a data)\n\n    whenever someone writes a message: insert\n    whevenver state of message chagnes: update\n\n    total : 3\n    save the message\n    sent to delivered\n    delivered to read",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "write throuput: \n    no of ways to write in the system (adding / updatin a data)\n\n    whenever someone writes a message: insert\n    whevenver state of message chagnes: update\n\n    total : 3\n    save the message\n    sent to delivered\n    delivered to read",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VpKF12_aH48gG6MKkY7g5",
      "type": "text",
      "x": 9509.021932885913,
      "y": 27801.699075315035,
      "width": 981.5673828125,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a7",
      "roundness": null,
      "seed": 258396363,
      "version": 428,
      "versionNonce": 877518885,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776902916331,
      "link": null,
      "locked": false,
      "text": "read throuput: \n    no of ways to read from the system ()\n\n    whenever receivers reads a message\n    whevenver state of message chagnes, sender need to be notified with state\n\n    total : 3\n    read the received message\n    sent to delivered\n    delivered to read",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "read throuput: \n    no of ways to read from the system ()\n\n    whenever receivers reads a message\n    whevenver state of message chagnes, sender need to be notified with state\n\n    total : 3\n    read the received message\n    sent to delivered\n    delivered to read",
      "autoResize": true,
      "lineHeight": 1.25
    },
