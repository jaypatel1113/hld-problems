      "link": null,
      "locked": false,
      "text": "Problem\n    Max sends message to server\n    Server must send message to Emily\n    But server cannot start communication in HTTP",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Problem\n    Max sends message to server\n    Server must send message to Emily\n    But server cannot start communication in HTTP",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "i4sU2DTPMqdJAO7XzaTw_",
      "type": "rectangle",
      "x": 9297.934762520916,
      "y": 31858.526646685634,
      "width": 515.5476114811008,
