      "isDeleted": false,
      "boundElements": null,
      "updated": 1776904922257,
      "link": null,
      "locked": false,
      "text": "1. HTTP\n\nHow it works\n    Client → sends request\n    Server → sends response\n    Connection closes\n    \nUse in chat\n    Max can send message to server\n    But server cannot push message to Emily\n\nLimitation\n    One-way only\n    Not real-time",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. HTTP\n\nHow it works\n    Client → sends request\n    Server → sends response\n    Connection closes\n    \nUse in chat\n    Max can send message to server\n    But server cannot push message to Emily\n\nLimitation\n    One-way only\n    Not real-time",
      "autoResize": true,
      "lineHeight": 1.25
    },
