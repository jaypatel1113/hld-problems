      "text": "User Operations\n    POST /v1/user/register — Register with phone/OTP or email/password\n    POST /v1/user/login — Login and receive JWT token",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "User Operations\n    POST /v1/user/register — Register with phone/OTP or email/password\n    POST /v1/user/login — Login and receive JWT token",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "48TNE4AFMEit3slmhSb9m",
      "type": "text",
      "x": 9368.9258667535,
      "y": 31010.50669442315,
      "width": 1088.05126953125,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "UAZ8rneUOkteE4YOGzONR",
        "gDEfAYOYaknIvO4s_Wkiv"
