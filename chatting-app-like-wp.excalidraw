      "version": 120,
      "versionNonce": 1544825739,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776903320800,
      "link": null,
      "locked": false,
      "text": "One on One Messaging\n    WS /v1/messages/send — Send message via WebSocket {receiver_id, content, type}\n    GET /v1/messages/{userId} — Retrieve message history with pagination\n    WS /v1/user/{userId}/isOnline — Subscribe to user's online status via WebSocket",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "One on One Messaging\n    WS /v1/messages/send — Send message via WebSocket {receiver_id, content, type}\n    GET /v1/messages/{userId} — Retrieve message history with pagination\n    WS /v1/user/{userId}/isOnline — Subscribe to user's online status via WebSocket",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_bEARGUk2dVBcaVkcE6iM",
      "type": "text",
