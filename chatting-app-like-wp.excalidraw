    {
      "id": "vaDqfJxyTTUOJILBGaZr5",
      "type": "text",
      "x": 8624.184115139771,
      "y": 34185.33034652555,
      "width": 525.3916625976562,
      "height": 385,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0p",
      "roundness": null,
      "seed": 1022523659,
      "version": 105,
      "versionNonce": 2039944587,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776906360281,
      "link": null,
      "locked": false,
      "text": "Emily opens app\n    sends → “I am active” + time\n\nWhile using app\n    keeps sending time (every few sec/min)\n\nEmily closes app\n    stops sending updates\n\nServer stores last time\n    that becomes last seen",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Emily opens app\n    sends → “I am active” + time\n\nWhile using app\n    keeps sending time (every few sec/min)\n\nEmily closes app\n    stops sending updates\n\nServer stores last time\n    that becomes last seen",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "9EoeULByUY3R41LGBBr0u",
      "type": "text",
      "x": 9369.855050538337,
      "y": 34185.33034735833,
      "width": 318.3038330078125,
      "height": 245,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0q",
      "roundness": null,
      "seed": 388971563,
      "version": 244,
      "versionNonce": 677096997,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776906603675,
      "link": null,
      "locked": false,
      "text": "When Max checks\n    Max asks server:\n    “Emily status?”\n\nServer replies:\n    if active → online\n    else → last seen (time)",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When Max checks\n    Max asks server:\n    “Emily status?”\n\nServer replies:\n    if active → online\n    else → last seen (time)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "TypN0GHnfCPjp0PFTF0ek",
      "type": "text",
      "x": 10266.887186483853,
      "y": 34160.82014335833,
      "width": 604.4356689453125,
      "height": 490,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0qV",
      "roundness": null,
      "seed": 1692740619,
      "version": 330,
      "versionNonce": 2135646987,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776906636976,
      "link": null,
      "locked": false,
      "text": "Flow\n\nMax sends message in group\n    message goes to server\n\nServer gets group message\n    checks group members\n\nServer sends same message to all members\n    Amanda gets it\n    Mike gets it\n\nEach member receives through own WebSocket\n    server sends separately to each user",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Flow\n\nMax sends message in group\n    message goes to server\n\nServer gets group message\n    checks group members\n\nServer sends same message to all members\n    Amanda gets it\n    Mike gets it\n\nEach member receives through own WebSocket\n    server sends separately to each user",
      "autoResize": true,
      "lineHeight": 1.25
    },
