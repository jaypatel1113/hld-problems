      "versionNonce": 1159675541,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776233590120,
      "link": null,
      "locked": false,
      "text": "create a short url from long url\n    optional: supports custom url\n    optional: supports expiration date\nUser should be able to get redirect to original url from short url\n\nhow much short url ? as much as possible",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "create a short url from long url\n    optional: supports custom url\n    optional: supports expiration date\nUser should be able to get redirect to original url from short url\n\nhow much short url ? as much as possible",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "vrI_8Tb1SXQkRPFU-yJc6",
      "type": "text",
      "x": -40652.232099104964,
      "y": -1854.6731489992644,
      "width": 905.3636474609375,
