      "index": "aAV",
      "roundness": null,
      "seed": 191975704,
      "version": 1280,
      "versionNonce": 1441116181,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "cx2Yp6YITZXtGSB9KQTl6",
