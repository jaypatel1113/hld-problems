      "boundElements": [],
      "updated": 1776233590120,
      "link": null,
      "locked": false,
      "text": "consider :\n\nspeed:                         we need to quickly fetch from db                no sql\nscale                           handling millions of request                       no sql\nQuery Pattern               simple query pattern                                no sql\nStructure flexibility         doesnt matter since we have few fields\n\n\n\nbase on this we select \n\n\n\n\nDB Modelling :\n\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "consider :\n\nspeed:                         we need to quickly fetch from db                no sql\nscale                           handling millions of request                       no sql\nQuery Pattern               simple query pattern                                no sql\nStructure flexibility         doesnt matter since we have few fields\n\n\n\nbase on this we select \n\n\n\n\nDB Modelling :\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
