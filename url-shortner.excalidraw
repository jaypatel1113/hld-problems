    {
      "id": "hM089FzYEDmrkSzchf3_u",
      "type": "text",
      "x": -40598.637535426315,
      "y": -1763.2077069505324,
      "width": 426.8878173828125,
      "height": 90,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8c",
