      "updated": 1776232932285,
      "link": null,
      "locked": false,
      "text": "Non functional: \nLow latency : on redirect and on creation (~200ms)\nscale: 10M URLS / day\nshort url should be always unique\nCAP: Availibility >>> consistency (eventual)",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non functional: \nLow latency : on redirect and on creation (~200ms)\nscale: 10M URLS / day\nshort url should be always unique\nCAP: Availibility >>> consistency (eventual)",
      "autoResize": true,
