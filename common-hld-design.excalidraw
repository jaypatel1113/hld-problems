      "updated": 1776232929259,
      "link": null,
      "locked": false,
      "text": "Functional : \ncreate a short url from long url\n    optional: supports custom url\n    optional: supports expiration date\nUser should be able to get redirect to original url from short url\n\nhow much short url ? as much as possible",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional : \ncreate a short url from long url\n    optional: supports custom url\n    optional: supports expiration date\nUser should be able to get redirect to original url from short url\n\nhow much short url ? as much as possible",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
