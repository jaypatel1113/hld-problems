    {
      "id": "Bj2jhZJMI6FkshZsMJJeG",
      "type": "text",
      "x": -663.8715793394817,
      "y": 2404.1061136548706,
      "width": 1374.699479844835,
      "height": 147.5,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#121212",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
