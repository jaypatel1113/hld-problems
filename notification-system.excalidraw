      "boundElements": null,
      "updated": 1776365548548,
      "link": null,
      "locked": false,
      "text": "egress: data flowing out system\n\nassume 15% is filtered out and 85% is delivered\n\n\nper day storage = 120GB\n\n85% of 120GB / day     100 GB / day\n\n\n100GB  / 100K   =  1MB / s",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "egress: data flowing out system\n\nassume 15% is filtered out and 85% is delivered\n\n\nper day storage = 120GB\n\n85% of 120GB / day     100 GB / day\n\n\n100GB  / 100K   =  1MB / s",
      "autoResize": true,
      "lineHeight": 1.25
    },
