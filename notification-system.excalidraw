    {
      "id": "HJJsO9XOk3BtcihvUpOBI",
      "type": "text",
      "x": -33693.34639689796,
      "y": -9126.738655854637,
      "width": 1274.903564453125,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a4",
      "roundness": null,
      "seed": 933203093,
      "version": 55,
      "versionNonce": 1390934491,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776374465354,
      "link": null,
      "locked": false,
      "text": "1. Functional Requirements\n    - Support multiple delivery channels (email, SMS, push notifications, in-app)\n    - Create, update, and manage notification templates with dynamic content\n    - Allow users to configure notification preferences per channel and type\n    - Support immediate and scheduled notification delivery",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Functional Requirements\n    - Support multiple delivery channels (email, SMS, push notifications, in-app)\n    - Create, update, and manage notification templates with dynamic content\n    - Allow users to configure notification preferences per channel and type\n    - Support immediate and scheduled notification delivery",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "BKpSHpbVhvzzlceowEolg",
      "type": "text",
      "x": -32260.284059298167,
      "y": -9130.10935468072,
      "width": 776.5916748046875,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a5",
      "roundness": null,
      "seed": 1946661755,
      "version": 66,
      "versionNonce": 1856980085,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776361825817,
      "link": null,
      "locked": false,
      "text": "Non Functional Requirements\n- Scale: 1M+ notifications/min\n- CAP: Availability >> Consistency\n- Latency: Real-time delivery for high-priority\nnotifications (OTP), 5-10s delay for promotional\nnotification",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non Functional Requirements\n- Scale: 1M+ notifications/min\n- CAP: Availability >> Consistency\n- Latency: Real-time delivery for high-priority\nnotifications (OTP), 5-10s delay for promotional\nnotification",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "9vo_LkI_22kqqpv2npmad",
      "type": "text",
      "x": -32761.048218174754,
      "y": -7251.442193771574,
      "width": 578.48388671875,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
