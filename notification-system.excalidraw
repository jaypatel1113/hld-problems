      "versionNonce": 47787253,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776366209032,
      "link": null,
      "locked": false,
      "text": "3. Core Entity (from 1)\n- Client (amazon, flipcart)\n- User (person who use client apps)\n- NotificationPreferences\n- NotificationContent\n- Template\n- DeliveryStatus",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. Core Entity (from 1)\n- Client (amazon, flipcart)\n- User (person who use client apps)\n- NotificationPreferences\n- NotificationContent\n- Template\n- DeliveryStatus",
      "autoResize": true,
      "lineHeight": 1.25
    },
