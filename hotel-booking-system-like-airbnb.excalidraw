    {
      "id": "9u9fI3Fo5wfM29Ioc16NP",
      "type": "text",
      "x": 16230.987885322187,
      "y": 49084.05407204668,
      "width": 2574.542236328125,
      "height": 245,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bVT",
      "roundness": null,
      "seed": 2038210463,
      "version": 1439,
      "versionNonce": 1259835423,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779743721275,
      "link": null,
      "locked": false,
      "text": "first we will define user who will be usign out application \nlooking at then non functional requierments - the scale of system we are desigin is huge. so we will be going with microservice architecture or distrubuted architecture rather than mono lythic architecture .\nsince it will be micro service architecutre.. we will be needing load balance before each service - to route to random servver out of avialable servers.\nnow to decide which servcie to call we can use apigateway which will decide which service (loadbalancer) to call base on api endpoint.\napi gateway will be responsible for authorizatin, authenticalion, rate limiting and request routing\nload balncer is resposnsible for balancing load betweeen multiple instacne of servers. ther4e is multiple algorithm like round robin, weighted round robin, least connection, ip hash, least response time\nwe will be usikgn simple one thatws round robin.",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "first we will define user who will be usign out application \nlooking at then non functional requierments - the scale of system we are desigin is huge. so we will be going with microservice architecture or distrubuted architecture rather than mono lythic architecture .\nsince it will be micro service architecutre.. we will be needing load balance before each service - to route to random servver out of avialable servers.\nnow to decide which servcie to call we can use apigateway which will decide which service (loadbalancer) to call base on api endpoint.\napi gateway will be responsible for authorizatin, authenticalion, rate limiting and request routing\nload balncer is resposnsible for balancing load betweeen multiple instacne of servers. ther4e is multiple algorithm like round robin, weighted round robin, least connection, ip hash, least response time\nwe will be usikgn simple one thatws round robin.",
      "autoResize": true,
      "lineHeight": 1.25
    },
