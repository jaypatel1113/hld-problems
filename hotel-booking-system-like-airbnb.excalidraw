    {
      "id": "_SAj9iOLaEk268uFdyjF9",
      "type": "text",
      "x": 22251.060605539195,
      "y": 43715.99879811033,
      "width": 1132.375244140625,
      "height": 245,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "D4o8Bu_Pn6twGb7gjvnCC",
        "DE77SXX6KpuR19jWmqmrh",
        "K0x2oBap-Gtcf4fdB1VNH",
        "yH_6nJM9zWQ3lXhNFvPT8",
        "VUC7AFic4neijwuood9F7",
        "avU27ZgV4Ni1Ag53chbX6"
      ],
      "frameId": null,
      "index": "beR",
      "roundness": null,
      "seed": 1237329348,
      "version": 645,
      "versionNonce": 487542333,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779808166767,
      "link": null,
      "locked": false,
      "text": "for image upload:\n    client first requests pre-signed URL from property svc.\n    property svc returns pre-signed URL.\n    client uploads images directly to object storage like S3 using that URL.\n    after upload is complete, property svc stores image URLs and metadata in property DB.\n    images are pushed/served through CDN.\n    next time client can fetch images from nearest CDN edge location.",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "for image upload:\n    client first requests pre-signed URL from property svc.\n    property svc returns pre-signed URL.\n    client uploads images directly to object storage like S3 using that URL.\n    after upload is complete, property svc stores image URLs and metadata in property DB.\n    images are pushed/served through CDN.\n    next time client can fetch images from nearest CDN edge location.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "HFwvNHGepTi1VyFfVvfYX",
      "type": "text",
      "x": 22699.441858027338,
      "y": 50306.216586886374,
      "width": 876.1753540039062,
      "height": 385,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "D4o8Bu_Pn6twGb7gjvnCC",
        "DE77SXX6KpuR19jWmqmrh",
        "K0x2oBap-Gtcf4fdB1VNH",
        "yH_6nJM9zWQ3lXhNFvPT8",
        "VUC7AFic4neijwuood9F7",
        "avU27ZgV4Ni1Ag53chbX6"
      ],
      "frameId": null,
      "index": "beS",
      "roundness": null,
      "seed": 1411903347,
      "version": 290,
      "versionNonce": 2030141459,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779808166767,
      "link": null,
      "locked": false,
      "text": "Payment callback must be idempotent.\n\nPayment gateway can send the same callback multiple times.\n\nPayment svc stores transactionId/paymentId with a unique constraint.\n\nIf same transactionId is received again,\nPayment svc does not process it again.\nIt simply returns success response.\n\nThis prevents duplicate confirmation or duplicate Kafka events.",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Payment callback must be idempotent.\n\nPayment gateway can send the same callback multiple times.\n\nPayment svc stores transactionId/paymentId with a unique constraint.\n\nIf same transactionId is received again,\nPayment svc does not process it again.\nIt simply returns success response.\n\nThis prevents duplicate confirmation or duplicate Kafka events.",
      "autoResize": true,
      "lineHeight": 1.25
    },
