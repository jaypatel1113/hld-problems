      "updated": 1779731064037,
      "link": null,
      "locked": false,
      "text": "all incoming data is stored in storage.\nby storage calculation per day storage is  10.35GB/day",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "all incoming data is stored in storage.\nby storage calculation per day storage is  10.35GB/day",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5zMlniTzuEcGFuRUer7JL",
      "type": "text",
      "x": 17498.578390211645,
      "y": 45499.183839300735,
      "width": 647.5834350585938,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
