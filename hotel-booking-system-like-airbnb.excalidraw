    },
    {
      "id": "GY0x4H8d5gha16hZWPko0",
      "type": "text",
      "x": 23049.681590758824,
      "y": 51787.60376947331,
      "width": 829.443359375,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "ii-FjtW2FY8OekXUPBcpb",
        "avU27ZgV4Ni1Ag53chbX6"
      ],
      "frameId": null,
      "index": "beX",
      "roundness": null,
      "seed": 2054602813,
      "version": 208,
      "versionNonce": 406928221,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779808166767,
      "link": null,
      "locked": false,
      "text": "Notification svc calls external providers like FCM/APNs.\n\nWe can use Circuit Breaker here also.\n\nIf FCM/APNs is down:\n    circuit opens\n    notification events stay in Kafka / retry queue\n    notification svc retries later\n\nBooking should not fail just because notification provider is down.",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Notification svc calls external providers like FCM/APNs.\n\nWe can use Circuit Breaker here also.\n\nIf FCM/APNs is down:\n    circuit opens\n    notification events stay in Kafka / retry queue\n    notification svc retries later\n\nBooking should not fail just because notification provider is down.",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
