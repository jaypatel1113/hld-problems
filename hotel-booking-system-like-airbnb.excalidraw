      "isDeleted": false,
      "boundElements": [],
      "updated": 1779731064037,
      "link": null,
      "locked": false,
      "text": "data going out per second  =   15TB / 100K  =    0.15GB / second      = 150MB / sec\n\npeak traffic at 10x     = 1.5GB / sec",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
