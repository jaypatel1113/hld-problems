    {
      "id": "15nvfhltVVZYtiJrEYhTB",
      "type": "text",
      "x": 18108.766934179603,
      "y": 48179.76054394572,
      "width": 1317.3115234375,
      "height": 675,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
