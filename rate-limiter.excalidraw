      "seed": 1551000367,
      "version": 454,
      "versionNonce": 1358643489,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776276754516,
      "link": null,
      "locked": false,
      "text": "how decision is made if req is allowed or blocked ?\nby using count\n\n\nwe will keep track of req counter which stores deatils of user req for that pariticualt api \nif req count is below thresold then we will allow \nelse HTTP 429\n\n\nwhere do we store this countter ?? \nDB ? NO, coz db are too slow coz we are doing frequent checks\n\nso instead of db we will use redis ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "how decision is made if req is allowed or blocked ?\nby using count\n\n\nwe will keep track of req counter which stores deatils of user req for that pariticualt api \nif req count is below thresold then we will allow \nelse HTTP 429\n\n\nwhere do we store this countter ?? \nDB ? NO, coz db are too slow coz we are doing frequent checks\n\nso instead of db we will use redis ",
      "autoResize": true,
      "lineHeight": 1.25
    },
