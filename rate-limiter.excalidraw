    {
      "id": "fXTatXXqyCj8ocYg3iBzg",
      "type": "text",
      "x": -38777.083896465665,
      "y": -6121.395951278185,
      "width": 1151.9276123046875,
      "height": 675,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "G7cIAkIHUTeg3Zoxu-HVF"
      ],
      "frameId": null,
      "index": "b17V",
      "roundness": null,
      "seed": 1644290255,
      "version": 663,
      "versionNonce": 795029089,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776281145115,
      "link": null,
      "locked": false,
      "text": "4. Sliding Window Log\n\n    Solves the issue of prev 3rd algo problem (more than limit on edges)\n    Store timestamp of each request.\n    \n    Example:\n    \n    Limit = 5 req / 10 sec\n    Store timestamps of each request\n    At any time, check last 10 sec requests\n    \n    If already 5 requests in last 10 sec → reject new request\n    \n    Very accurate\n    Uses more memory to store time stamps",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. Sliding Window Log\n\n    Solves the issue of prev 3rd algo problem (more than limit on edges)\n    Store timestamp of each request.\n    \n    Example:\n    \n    Limit = 5 req / 10 sec\n    Store timestamps of each request\n    At any time, check last 10 sec requests\n    \n    If already 5 requests in last 10 sec → reject new request\n    \n    Very accurate\n    Uses more memory to store time stamps",
      "autoResize": true,
      "lineHeight": 1.25
    },
