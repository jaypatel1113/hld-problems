    },
    {
      "id": "fxrfZfj8P6_8ge4K_eb_G",
      "type": "text",
      "x": -40162.35906681548,
      "y": -13651.725598593459,
      "width": 574.3078002929688,
      "height": 45,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
