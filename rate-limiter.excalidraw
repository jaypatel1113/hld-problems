    {
      "id": "KuNMdXoacCS4Hlg7f39qK",
      "type": "text",
      "x": -39952.40804831804,
      "y": -7530.938483520093,
      "width": 757.979736328125,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0n",
      "roundness": null,
      "seed": 998177551,
      "version": 211,
      "versionNonce": 639244047,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776277447550,
      "link": null,
      "locked": false,
      "text": "There are 5 ways to implement rate limiting\n\n1. Token bucket\n2. Leaky bucket\n3. Fixed window counter\n4. Sliding window log\n5. Sliding window counter",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "There are 5 ways to implement rate limiting\n\n1. Token bucket\n2. Leaky bucket\n3. Fixed window counter\n4. Sliding window log\n5. Sliding window counter",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "IcS5hXQmwtFsfx3M8zLVj",
      "type": "arrow",
      "x": -39923.235342805114,
      "y": -7865.177610811737,
      "width": 673.6782262649212,
      "height": 31.267765776008673,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
