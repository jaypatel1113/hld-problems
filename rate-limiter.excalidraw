    {
      "id": "9wsij2EyMveaWiIEYliee",
      "type": "text",
      "x": -40015.08597538475,
      "y": -11005.734590640512,
      "width": 1586.9517822265625,
      "height": 585,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
