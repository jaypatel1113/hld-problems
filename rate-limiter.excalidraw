      "text": "Step 6: Race condition",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Step 6: Race condition",
      "autoResize": true,
