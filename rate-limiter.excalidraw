    },
    {
      "id": "zxJxsVlU65Kf4mTzjO0_5",
      "type": "text",
      "x": -40117.56091707604,
      "y": -2671.6418881712802,
      "width": 1051.523681640625,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "2LIoEmnd_v54F0LZa6e_u"
      ],
      "frameId": null,
      "index": "b2I",
      "roundness": null,
      "seed": 2058123841,
      "version": 195,
      "versionNonce": 470381487,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776281549931,
      "link": null,
      "locked": false,
      "text": "When multiple requests from same user come at the same time, \nthey may update the counter simultaneously.",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When multiple requests from same user come at the same time, \nthey may update the counter simultaneously.",
      "autoResize": true,
      "lineHeight": 1.25
    },
