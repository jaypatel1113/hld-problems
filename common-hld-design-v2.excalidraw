      "originalText": "1 char → 62\n2 chars → 62² = 3,844\n3 chars → 238,328\n4 chars → 14,776,336\n5 chars → 916,132,832 (~0.9B)\n6 chars → 56,800,235,584 (~56.8B)\n7 chars → 3,521,614,606,208 (~3.5T)",
      "autoResize": true,
      "lineHeight": 1.25
