      "text": "Validation DB\n\nNoSQL\n\ntemporary status tracking\n\n{\n  \"messageId\": \"m123\",\n  \"attachmentCheck\": \"PASS\",\n  \"spamCheck\": \"PASS\",\n  \"policyCheck\": \"PASS\",\n  \"recipientCheck\": \"PASS\",\n  \"finalStatus\": \"VALIDATED\"\n}\n\nPK: messageId",
