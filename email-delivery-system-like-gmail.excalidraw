    {
      "id": "qEGfWZ6tAwgtonH8sir6P",
      "type": "text",
      "x": 6622.286634375592,
      "y": 37273.52104388806,
      "width": 791.9234008789062,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
