      "boundElements": null,
      "updated": 1777088668792,
      "link": null,
      "locked": false,
      "text": "User DB\n\nSQL \n\nemail_id uniqueness required\nand also structural data\n\n{\n  \"userId\": \"u123\",\n  \"emailId\": \"abc@gmail.com\",\n  \"name\": \"Aman\",\n  \"passwordHash\": \"...\",\n  \"createdAt\": 1720748150,\n  \"status\": \"ACTIVE\"\n}\n\n\nPK: userId\nUniqueID: emailId",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "User DB\n\nSQL \n\nemail_id uniqueness required\nand also structural data\n\n{\n  \"userId\": \"u123\",\n  \"emailId\": \"abc@gmail.com\",\n  \"name\": \"Aman\",\n  \"passwordHash\": \"...\",\n  \"createdAt\": 1720748150,\n  \"status\": \"ACTIVE\"\n}\n\n\nPK: userId\nUniqueID: emailId",
      "autoResize": true,
      "lineHeight": 1.25
