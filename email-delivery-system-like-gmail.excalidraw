      "text": "Mailbox DB\n\nNoSQL \n\nhuge scale, read by user_id + folder\n\n{\n  \"mailboxItemId\": \"mb123\",\n  \"userId\": \"u123\",\n  \"messageId\": \"m123\",\n  \"threadId\": \"t123\",\n  \"folder\": \"INBOX\",\n  \"from\": \"a@gmail.com\",\n  \"to\": [\"u123@gmail.com\"],\n  \"subject\": \"Hello\",\n  \"snippet\": \"Hi...\",\n  \"attachmentIds\": [\"a1\"],\n  \"status\": \"UNREAD\",\n  \"createdAt\": 1720748150\n}\n\nPK: userId",
