      "updated": 1777077017946,
      "link": null,
      "locked": false,
      "text": "- Create Account: POST /v1/accounts/register\n- Send Email: POST /v1/emails/send : Body: { to: [], cc: [], bcc: [], subject, body, attachmentIds[] }\n- GET /v1/emails/{emailId_UUID} : Response: { full Email object + attachments }\n- GET /v1/search?q=\"meeting tomorrow\"&userId=123&limit=20 { results: [EmailMetadata + snippets] }\n- POST /v1/attachments/upload (multipart form): { attachmentId, storageUr1 }",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Create Account: POST /v1/accounts/register\n- Send Email: POST /v1/emails/send : Body: { to: [], cc: [], bcc: [], subject, body, attachmentIds[] }\n- GET /v1/emails/{emailId_UUID} : Response: { full Email object + attachments }\n- GET /v1/search?q=\"meeting tomorrow\"&userId=123&limit=20 { results: [EmailMetadata + snippets] }\n- POST /v1/attachments/upload (multipart form): { attachmentId, storageUr1 }",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "adtY_3jwoDCVq7YIRSS2F",
      "type": "text",
      "x": 10796.961159593671,
      "y": 42438.95252882866,
      "width": 587.4116821289062,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
