    {
      "id": "Ytw4ZVlN_JKOpUPx2suu3",
      "type": "text",
      "x": 9437.097441386513,
      "y": 44463.21287642241,
      "width": 343.5037841796875,
      "height": 630,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
