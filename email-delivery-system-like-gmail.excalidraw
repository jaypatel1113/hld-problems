      "isDeleted": false,
      "boundElements": null,
      "updated": 1777074815777,
      "link": null,
      "locked": false,
      "text": "5B * 1.5 = 7.5B mailbox deliveries/day",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "5B * 1.5 = 7.5B mailbox deliveries/day",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wZIiHDgzZ0CJZjDnaQny4",
      "type": "text",
      "x": 6775.38480110476,
      "y": 38605.774797692524,
      "width": 535.130859375,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1H",
      "roundness": null,
      "seed": 1586011161,
      "version": 36,
      "versionNonce": 1065054103,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777074815777,
      "link": null,
      "locked": false,
      "text": "per second = 7.5B / 100K ≈ 75K writes/sec",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "per second = 7.5B / 100K ≈ 75K writes/sec",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
