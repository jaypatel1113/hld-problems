    {
      "id": "uSMZp25e8zQjX7SP_QfYM",
      "type": "text",
      "x": 2442.541524647818,
      "y": 47134.32808814894,
      "width": 987.7315063476562,
      "height": 720,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bF4",
      "roundness": null,
      "seed": 1931180628,
      "version": 157,
      "versionNonce": 1023053164,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777421526041,
      "link": null,
      "locked": false,
      "text": "\n\nScenario 2: Resume Upload (Connection Dropped)\nUser was uploading, network failed, now resuming ...\nPOST /api/v1/files/upload/init\nRequest: {\n    \"fileName\": \"vacation.mp4\",\n    \"fileSize\": 524288000,|\n    \"resumeUploadId\": \"upload_123\" // Previous upload ID\n}\n\nResponse: {\n    \"fileId\": \"file_789\",\n    \"uploadId\": \"upload_123\",\n    \"existingChunks\": [1, 2, 3, 4, 5] // Chunks already uploaded\n}",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n\nScenario 2: Resume Upload (Connection Dropped)\nUser was uploading, network failed, now resuming ...\nPOST /api/v1/files/upload/init\nRequest: {\n    \"fileName\": \"vacation.mp4\",\n    \"fileSize\": 524288000,|\n    \"resumeUploadId\": \"upload_123\" // Previous upload ID\n}\n\nResponse: {\n    \"fileId\": \"file_789\",\n    \"uploadId\": \"upload_123\",\n    \"existingChunks\": [1, 2, 3, 4, 5] // Chunks already uploaded\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wCUgyj0TdI9FLrAj7omKV",
      "type": "text",
      "x": 1449.1240693956167,
      "y": 47134.328087790236,
      "width": 823.067626953125,
      "height": 720,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bF5",
      "roundness": null,
      "seed": 459049044,
      "version": 221,
      "versionNonce": 1840247508,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1777421500977,
      "link": null,
      "locked": false,
      "text": "Step 1: Initiate Upload by File Upload Svc\n\nScenario 1: Brand New File (First Time Upload)\nPOST /api/v1/files/upload/init\nRequest: {\n    \"fileName\": \"vacation.mp4\",\n    \"fileSize\": 524288000,\n    \"parentFolderId\": \"root\"\n}\n\nResponse: {\n    \"fileId\": \"file_789\",\n    \"uploadId\": \"upload 123\",\n    \"chunkSize\": 5MB,\n    \"existingChunks\": [] // Empty - nothing exists yet\n}",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Step 1: Initiate Upload by File Upload Svc\n\nScenario 1: Brand New File (First Time Upload)\nPOST /api/v1/files/upload/init\nRequest: {\n    \"fileName\": \"vacation.mp4\",\n    \"fileSize\": 524288000,\n    \"parentFolderId\": \"root\"\n}\n\nResponse: {\n    \"fileId\": \"file_789\",\n    \"uploadId\": \"upload 123\",\n    \"chunkSize\": 5MB,\n    \"existingChunks\": [] // Empty - nothing exists yet\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
