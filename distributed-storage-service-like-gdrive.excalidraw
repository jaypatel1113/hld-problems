      "text": "Cross-region replication\nvia events (Kafka / CDC)\n(Eventual Consistent)",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "DDzFjzv2pJF9Qym1TA1XU",
