    },
    {
      "id": "S2uOuNZfAOfwiDP5Bse9P",
      "type": "text",
      "x": 1972.9002048303778,
      "y": 44485.42385191027,
      "width": 829.9432962440789,
      "height": 770,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0z",
      "roundness": null,
      "seed": 779606883,
      "version": 813,
      "versionNonce": 2132824404,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777422920855,
      "link": null,
      "locked": false,
      "text": "Create Account: POST /v1/accounts/register\n\nDownload File: GET /v1/files/{fileId}/download\nGet File Metadata: GET /v1/files/{fileId}\nList Folder: GET /v1/folders/{folderId}/files?limit=20\n\nCreate Folder: POST /v1/folders\nBody: { userId, parentFolderId, folderName }\n\nShare File/Folder: POST /v1/share\nBody: { resourceId, resourceType, targetUserId, permission }\n\nSearch Files: GET /v1/search?q=\"resume\"&userId=123&limit=20\n\nFile Operations\n- POST    /api/v1/files/upload/init : Initialize Upload\n- POST    /api/v1/files/uploads/{uploadId}/chunk-url\n- POST    /api/v1/files/{uploadId}/chunks : Upload chunks\n- POST    /api/v1/files/uploads/{uploadId}/commit: Confirm upload\n- GET      /api/v1/files/{fileId}/download\n- PUT/DEL /api/v1/files/{fileId}\n.. other CRUD",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Create Account: POST /v1/accounts/register\n\nDownload File: GET /v1/files/{fileId}/download\nGet File Metadata: GET /v1/files/{fileId}\nList Folder: GET /v1/folders/{folderId}/files?limit=20\n\nCreate Folder: POST /v1/folders\nBody: { userId, parentFolderId, folderName }\n\nShare File/Folder: POST /v1/share\nBody: { resourceId, resourceType, targetUserId, permission }\n\nSearch Files: GET /v1/search?q=\"resume\"&userId=123&limit=20\n\nFile Operations\n- POST    /api/v1/files/upload/init : Initialize Upload\n- POST    /api/v1/files/uploads/{uploadId}/chunk-url\n- POST    /api/v1/files/{uploadId}/chunks : Upload chunks\n- POST    /api/v1/files/uploads/{uploadId}/commit: Confirm upload\n- GET      /api/v1/files/{fileId}/download\n- PUT/DEL /api/v1/files/{fileId}\n.. other CRUD",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "wZIiHDgzZ0CJZjDnaQny4",
