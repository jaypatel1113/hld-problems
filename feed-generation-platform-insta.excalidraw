    },
    {
      "id": "S2uOuNZfAOfwiDP5Bse9P",
      "type": "text",
      "x": 10107.52420995178,
      "y": 40218.64451527447,
      "width": 817.347412109375,
      "height": 805,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0z",
      "roundness": null,
      "seed": 779606883,
      "version": 37,
      "versionNonce": 1925705549,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776986888815,
      "link": null,
      "locked": false,
      "text": "1. User Onboarding\n- POST /api/v1/users/register\n- POST /api/v1/users/login\n- GET /api/v1/users/{user_id}/profile\n- PUT /api/v1/users/{user_id}/profile\n\n2. Post\n- POST /api/v1/posts\n- GET /api/v1/posts/{post_id}\n- PUT /api/v1/posts/{post_id}\n- DELETE /api/v1/posts/{post_id}\n- GET /api/v1/posts/feed?limit={limit}&offset={offset} :Pagination\n- GET /api/v1/users/{user_id}/posts: Pagination\n\n3, Interaction\n- POST /api/v1/posts/{post_id}/like\n- DELETE /api/v1/posts/{post_id}/unlike\n- POST /api/v1/posts/{post_id}/comments\n- GET /api/v1/posts/{post_id}/comments\n- PUT /api/v1/comments/{comment_id}\n- DELETE /api/v1/comments/{comment_id}\n- POST /api/v1/users/{user_id}/follow\n- DELETE /api/v1/users/{id}/unfollow",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. User Onboarding\n- POST /api/v1/users/register\n- POST /api/v1/users/login\n- GET /api/v1/users/{user_id}/profile\n- PUT /api/v1/users/{user_id}/profile\n\n2. Post\n- POST /api/v1/posts\n- GET /api/v1/posts/{post_id}\n- PUT /api/v1/posts/{post_id}\n- DELETE /api/v1/posts/{post_id}\n- GET /api/v1/posts/feed?limit={limit}&offset={offset} :Pagination\n- GET /api/v1/users/{user_id}/posts: Pagination\n\n3, Interaction\n- POST /api/v1/posts/{post_id}/like\n- DELETE /api/v1/posts/{post_id}/unlike\n- POST /api/v1/posts/{post_id}/comments\n- GET /api/v1/posts/{post_id}/comments\n- PUT /api/v1/comments/{comment_id}\n- DELETE /api/v1/comments/{comment_id}\n- POST /api/v1/users/{user_id}/follow\n- DELETE /api/v1/users/{id}/unfollow",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "r4_2Ij3YeC2WQjvXakVvG",
