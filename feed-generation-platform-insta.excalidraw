    {
      "id": "adtY_3jwoDCVq7YIRSS2F",
      "type": "text",
      "x": 10796.961159593671,
      "y": 42438.95252882866,
      "width": 587.4116821289062,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b11",
      "roundness": null,
      "seed": 1310486595,
      "version": 81,
      "versionNonce": 1584601997,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776989017667,
      "link": null,
      "locked": false,
      "text": "User creates post\n        ↓\nPost Service saves post as PENDING_REVIEW\n        ↓\nReview Queue\n        ↓\nModerator Service / Moderation Tool\n        ↓\nIf approved → Processing Queue\n        ↓\nMedia Processing Service\n        ↓\nSave final post in DB/CDN\n        ↓\nPost becomes ACTIVE",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "User creates post\n        ↓\nPost Service saves post as PENDING_REVIEW\n        ↓\nReview Queue\n        ↓\nModerator Service / Moderation Tool\n        ↓\nIf approved → Processing Queue\n        ↓\nMedia Processing Service\n        ↓\nSave final post in DB/CDN\n        ↓\nPost becomes ACTIVE",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "S2-coWa_zwT_brF5eD5gS",
