    {
      "id": "m7JTap6RzAg7hd-z6Ylbm",
      "type": "text",
      "x": 9139.997600687777,
      "y": 37012.617925634644,
      "width": 808.1915283203125,
      "height": 210,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#d0bfff",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aB",
      "roundness": null,
      "seed": 2021575710,
      "version": 13,
      "versionNonce": 1809783042,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776980515043,
      "link": null,
      "locked": false,
      "text": "Functional Requirements\n- Should be able to register and login to our application\n- Should be able to create post (text/image/video)\n- Should be able to follow each other (or send friend request)\n- Should be able to like/comment on post\n- Should be able to view the feed of post from users they follow",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements\n- Should be able to register and login to our application\n- Should be able to create post (text/image/video)\n- Should be able to follow each other (or send friend request)\n- Should be able to like/comment on post\n- Should be able to view the feed of post from users they follow",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4JhhkrirgfefIK5zPNOMZ",
      "type": "text",
      "x": 10053.118939016975,
      "y": 37012.61792561636,
      "width": 1368.21875,
      "height": 210,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#d0bfff",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aC",
      "roundness": null,
      "seed": 1918095390,
      "version": 494,
      "versionNonce": 766229250,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776980491137,
      "link": null,
      "locked": false,
      "text": "Non-Functional Requirements\n- Scale: 500M DAU   &    2B MAU\n- CAP Theorem: Availability >> Consistency  (Eventual Consistent)\n- Availibilit should be available 5 9's  99.999%\n- Latency: Low Latency: 500ms to upload post\n- Usability: show text even if image is not loaded, dont wait for both to load (rendering should be super fast)",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Non-Functional Requirements\n- Scale: 500M DAU   &    2B MAU\n- CAP Theorem: Availability >> Consistency  (Eventual Consistent)\n- Availibilit should be available 5 9's  99.999%\n- Latency: Low Latency: 500ms to upload post\n- Usability: show text even if image is not loaded, dont wait for both to load (rendering should be super fast)",
      "autoResize": true,
      "lineHeight": 1.25
    },
