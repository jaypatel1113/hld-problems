      "link": null,
      "locked": false,
      "text": "all read request is what data going out of system\nread s per second = 1B\nand avg size of video = 600mb\n\ndata going out per day  =  1b * 600mb  =  600PB / day",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "all read request is what data going out of system\nread s per second = 1B\nand avg size of video = 600mb\n\ndata going out per day  =  1b * 600mb  =  600PB / day",
      "autoResize": true,
