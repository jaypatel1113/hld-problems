    {
      "id": "DnF8rOJs9FE60uwMmZZHh",
      "type": "text",
      "x": -1395.654217404052,
      "y": 41175.17591238469,
      "width": 1651.8907680941568,
      "height": 13815,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "VB8INbESekRLb9sSObtEQ",
        "tLgKzq2TlKJWW869g6mIr"
      ],
      "frameId": null,
      "index": "bNE",
      "roundness": null,
      "seed": 281293140,
      "version": 1580,
