    {
      "id": "OK_lQx-N_tdX4zf5djIeK",
      "type": "text",
      "x": 1428.7944921374115,
      "y": 41692.47603387366,
      "width": 1298.591552734375,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bELzl",
      "roundness": null,
      "seed": 5348052,
      "version": 160,
      "versionNonce": 770751525,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1778475166125,
      "link": null,
      "locked": false,
      "text": "Functional Requirements\n    - User should be allowed to create account in our application\n    - Users can upload (resumed/disconnected) and download files of various size\n    - Changes sync across all devices automatically\n    - User should be able to share files/folders with other users (with permission)\n    - User should be able to - Create, delete, rename folders and organize files\n    - Quota / storage limit: per user quotas",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements\n    - User should be allowed to create account in our application\n    - Users can upload (resumed/disconnected) and download files of various size\n    - Changes sync across all devices automatically\n    - User should be able to share files/folders with other users (with permission)\n    - User should be able to - Create, delete, rename folders and organize files\n    - Quota / storage limit: per user quotas",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "kbm3ZEjVcEVgpExX27_U3",
      "type": "text",
      "x": 7915.314878137411,
      "y": 41857.29043587366,
      "width": 1344.5634765625,
      "height": 405,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bELzn",
      "roundness": null,
      "seed": 105221682,
      "version": 636,
      "versionNonce": 1215448370,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1778268615238,
      "link": null,
      "locked": false,
      "text": "Functional Requirement:\n\nViewers\n- user should be able to create account and opt for subscription.\n- user should be able search and finds movies/shows based on video title or names\n- Users can watch videos in different resolutions (480p,720p,1080p,4K,etc.)\n\nContent Creator\n- creators should be able to upload video",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirement:\n\nViewers\n- user should be able to create account and opt for subscription.\n- user should be able search and finds movies/shows based on video title or names\n- Users can watch videos in different resolutions (480p,720p,1080p,4K,etc.)\n\nContent Creator\n- creators should be able to upload video",
      "autoResize": true,
      "lineHeight": 1.25
    },
